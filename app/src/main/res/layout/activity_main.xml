<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local LLM Server"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <!-- ================= Status ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout style="@style/CardBody">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Service band hai"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="20dp"
                        app:trackThickness="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Endpoint (OpenAI base URL)"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEndpoint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="http://127.0.0.1:8080/v1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textIsSelectable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopy"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvModelId"
                    style="@style/Hint"
                    android:fontFamily="monospace"
                    android:text="model: -" />

                <TextView
                    android:id="@+id/tvTiming"
                    style="@style/Hint"
                    android:layout_marginTop="6dp"
                    android:text="" />

                <LinearLayout style="@style/Row">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnService"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Start server" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBench"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Speed test" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Model ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Model" />

                <TextView
                    android:id="@+id/tvModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Model nahi hai"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/tvModelInfo"
                    style="@style/Hint"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/downloadBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressDownload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tvDownload"
                        style="@style/Hint"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Download Gemma 4 E2B (3.1 GB)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPick"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone se .gguf file chuno" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Speed presets ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Speed preset (1 click)" />

                <TextView
                    android:id="@+id/tvCpu"
                    style="@style/Hint" />

                <LinearLayout style="@style/Row">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRocket"
                        style="@style/ToggleBtn"
                        android:text="🚀 Rocket" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBalanced"
                        style="@style/ToggleBtn"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="⚖️ Balanced" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuality"
                        style="@style/ToggleBtn"
                        android:text="🧠 Quality" />
                </LinearLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="6dp"
                    android:text="Rocket: chhota context, fast cores, q8 KV cache, chhote jawab, thinking off. Quality: bada context, thinking on. Preset ke baad neeche Save dabao." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= System prompt ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Default system prompt" />

                <TextView
                    style="@style/Hint"
                    android:text="Request me system message na ho tab ye lagta hai" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FieldFull">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Self learning ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Self-learning (chat se seekhna)" />

                <TextView
                    style="@style/Hint"
                    android:text="Khaali time me model pichli chats padh ke user ke baare me kaam ki baatein note karta hai (naam, pasand, kaam...). Ye baatein har request me yaad dilayi jaati hain. Model ki files nahi badalti." />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLearning"
                    style="@style/Switch"
                    android:text="Chats se seekho" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swUseMemory"
                    style="@style/Switch"
                    android:text="Seekhi baatein jawab me use karo" />

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Max yaad (baatein)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMaxMem"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvMemCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="0 baatein yaad"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>

                <LinearLayout style="@style/Row">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMemView"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Dekho / hatao" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMemClear"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Sab bhool jao" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Performance (model reload) ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Performance (badalne pe model reload)" />

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Context (0 = model max)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCtx"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Batch size">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBatch"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Threads (jawab)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etThreads"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Threads (prompt padhna)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etThreadsBatch"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FieldFull"
                    android:hint="Micro batch (ubatch)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUbatch"
                        style="@style/NumberInput" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="10dp"
                    android:text="Flash attention" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tgFlash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/faAuto"
                        style="@style/ToggleBtn"
                        android:text="Auto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/faOn"
                        style="@style/ToggleBtn"
                        android:text="On" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/faOff"
                        style="@style/ToggleBtn"
                        android:text="Off" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="10dp"
                    android:text="KV cache (q8/q4 = kam RAM, lambe context me tez)" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tgKv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kvF16"
                        style="@style/ToggleBtn"
                        android:text="f16" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kvQ8"
                        style="@style/ToggleBtn"
                        android:text="q8_0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kvQ4"
                        style="@style/ToggleBtn"
                        android:text="q4_0" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFastGen"
                    style="@style/Switch"
                    android:layout_marginTop="8dp"
                    android:text="Jawab sirf fast cores pe banao" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFastBatch"
                    style="@style/Switch"
                    android:text="Prompt padhna bhi sirf fast cores pe" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swMmap"
                    style="@style/Switch"
                    android:text="mmap (off = model poora RAM me, kabhi-kabhi tez)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Generation defaults ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Jawab ki setting (default)" />

                <TextView
                    style="@style/Hint"
                    android:text="Request me ye values bhejoge to wo use hongi" />

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Max tokens">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMaxTokens"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Temperature">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTemp"
                            style="@style/DecimalInput" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Top K">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTopK"
                            style="@style/NumberInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Top P">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTopP"
                            style="@style/DecimalInput" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Min P">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMinP"
                            style="@style/DecimalInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Repeat penalty">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRepeat"
                            style="@style/DecimalInput" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FieldFull"
                    android:hint="Repeat last N">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRepeatN"
                        style="@style/NumberInput" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swThinking"
                    style="@style/Switch"
                    android:layout_marginTop="8dp"
                    android:text="Thinking (&lt;thought&gt; block, sirf Gemma 4)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Server ================= -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Server" />

                <LinearLayout style="@style/Row">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="Port">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPort"
                            style="@style/NumberInput"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FieldHalf"
                        android:hint="API key (optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLan"
                    style="@style/Switch"
                    android:layout_marginTop="8dp"
                    android:text="WiFi network pe bhi allow karo (LAN)" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoStart"
                    style="@style/Switch"
                    android:text="Phone restart pe auto start" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💾 Save &amp; apply" />

        <!-- ================= Background ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_marginBottom="24dp">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Background me chalne ke liye" />

                <TextView
                    android:id="@+id/tvBattery"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBattery"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Battery optimization off karo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
